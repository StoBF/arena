[gd_scene load_steps=4 format=3 uid="uid://account-ui"]

[ext_resource type="Script" path="res://scripts/ui/AccountUI.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/StatPanel.tscn" id="2"]
[ext_resource type="PackedScene" path="res://scenes/ui/ChatPanel.tscn" id="3"]

[node name="AccountUI" type="Control"]
layout_mode = 3
anchors_preset = 0
script = ExtResource("1")

[node name="TopBar" type="HBoxContainer" parent="."]

[node name="Nickname" type="Label" parent="TopBar"]
text = "PlayerName"

[node name="Spacer" type="Control" parent="TopBar"]
size_flags_horizontal = 3

[node name="Currency" type="Label" parent="TopBar"]
text = "Currency: 0"

[node name="MainHBox" type="HBoxContainer" parent="."]

[node name="Sidebar" type="VBoxContainer" parent="MainHBox"]

[node name="CreateHero" type="Button" parent="MainHBox/Sidebar"]
text = "Create Hero"
[node name="TrainHero" type="Button" parent="MainHBox/Sidebar"]
text = "Train Hero"
[node name="Auction" type="Button" parent="MainHBox/Sidebar"]
text = "Auction"
[node name="Battle" type="Button" parent="MainHBox/Sidebar"]
text = "To Battle"
[node name="Inventory" type="Button" parent="MainHBox/Sidebar"]
text = "Inventory"
[node name="Deleted" type="Button" parent="MainHBox/Sidebar"]
text = "Deleted Heroes"

[node name="ContentStack" type="StackContainer" parent="MainHBox"]
# each window will be a child of this stack

[node name="StatsPanel" type="VBoxContainer" parent="MainHBox"]

[node name="StatPanelInstance" parent="MainHBox/StatsPanel" instance=ExtResource("2")]

[node name="ChatSection" type="VBoxContainer" parent="."]

[node name="Chat" parent="ChatSection" instance=ExtResource("3")]

[node name="BottomBar" type="HBoxContainer" parent="."]

[node name="Settings" type="Button" parent="BottomBar"]
text = "Settings"
[node name="Logout" type="Button" parent="BottomBar"]
text = "Logout"
